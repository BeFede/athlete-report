<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>Evolución semanal</title>
<style>
{% include "_style.css" %}
</style>
</head>
<body>
<header class="hero">
  <div class="wrap">
    <p class="kicker">Historial de entrenamiento</p>
    <h1>Evolución semanal</h1>
    <p class="meta">Tendencias y reportes de las últimas {{ entries | length }} semanas</p>
  </div>
</header>
<div class="wrap">

<nav class="weeknav">
  <a href="../reports/{{ latest }}/">Última semana</a>
</nav>

{% if trends %}
<section>
  <h2>Evolución semana a semana</h2>
  <div class="charts">
    {% for t in trends %}
    <div class="chart-card"><h3>{{ t.title }}</h3><p class="sub">{{ t.sub }}</p>{{ t.svg }}</div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if entries %}
<section>
<h2>Semanas</h2>
<ul class="archive-list">
  {% for e in entries %}
  <li>
    <a href="../reports/{{ e.value }}/">{{ e.label }}</a>
    <span class="stats">
      {%- if e.sessions %}{{ e.sessions }} sesiones{% endif %}
      {%- if e.distance %} · {{ e.distance }}{% endif %}
      {%- if e.duration %} · {{ e.duration }}{% endif -%}
    </span>
    <div class="sub">Generado el {{ e.generated_on }}{% if e.rebuilt_on %} · reconstruido el {{ e.rebuilt_on }}{% endif %}</div>
  </li>
  {% endfor %}
</ul>
</section>
{% else %}
<p class="empty">Todavía no hay reportes generados.</p>
{% endif %}
</div>
</body>
</html>
