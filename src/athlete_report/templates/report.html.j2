<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ week_title }}</title>
<style>
{% include "_style.css" %}
</style>
</head>
<body>
<div class="wrap">
<header class="report">
  <h1>{{ week_title }}</h1>
  <p class="meta">Generado el {{ generated_on }}</p>
  <p class="meta">Datos sincronizados hasta el {{ data_as_of_on }}</p>
  {% if rebuilt_on %}<p class="meta">Reconstruido el {{ rebuilt_on }}</p>{% endif %}
</header>

<nav class="weeknav">
  {% if nav.prev %}<a href="../{{ nav.prev }}/">&larr; Semana anterior</a>{% else %}<span class="disabled">&larr; Semana anterior</span>{% endif %}
  {% if nav.next %}<a href="../{{ nav.next }}/">Semana siguiente &rarr;</a>{% else %}<span class="disabled">Semana siguiente &rarr;</span>{% endif %}
  <span class="spacer"></span>
  <label>
    Semana:
    <select onchange="if(this.value)location.href='../'+this.value+'/'">
      {% for w in nav.weeks %}
      <option value="{{ w.value }}" {% if w.value == nav.current %}selected{% endif %}>{{ w.label }}</option>
      {% endfor %}
    </select>
  </label>
  <a href="../{{ nav.latest }}/">Última semana</a>
  <a href="../../archive/">Archivo</a>
</nav>

<div class="cards">
  <div class="card"><div class="label">Sesiones</div><div class="value">{{ totals.sessions }}</div></div>
  <div class="card"><div class="label">Tiempo</div><div class="value">{{ totals.duration }}</div></div>
  <div class="card"><div class="label">Distancia</div><div class="value">{{ totals.distance }}</div></div>
  <div class="card"><div class="label">Carga semanal</div><div class="value">{{ totals.load }}</div></div>
  <div class="card"><div class="label">Fitness (42 d)</div><div class="value">{{ fitness.fitness }}</div></div>
  <div class="card"><div class="label">Fatiga (7 d)</div><div class="value">{{ fitness.fatigue }}</div></div>
  <div class="card"><div class="label">Forma</div><div class="value">{{ fitness.form }}</div></div>
</div>

<section>
  <h2>Actividades</h2>
  {% if activities %}
  <table>
    <thead>
      <tr><th>Día</th><th>Actividad</th><th>Deporte</th><th class="num">Tiempo</th><th class="num">Distancia</th><th class="num">FC media</th><th class="num">Carga</th></tr>
    </thead>
    <tbody>
      {% for a in activities %}
      <tr>
        <td>{{ a.day }}</td><td>{{ a.name }}</td><td>{{ a.sport }}</td>
        <td class="num">{{ a.duration }}</td><td class="num">{{ a.distance }}</td>
        <td class="num">{{ a.avg_hr }}</td><td class="num">{{ a.load }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}<p class="empty">Sin actividades registradas esta semana.</p>{% endif %}
</section>

<section>
  <h2>Carga diaria</h2>
  {% if daily_load %}
  <table>
    <thead><tr><th>Día</th><th class="num">Carga</th><th style="width:45%">&nbsp;</th></tr></thead>
    <tbody>
      {% for d in daily_load %}
      <tr>
        <td>{{ d.day }}</td>
        <td class="num">{{ d.load }}</td>
        <td><div class="bar"><i style="width: {{ d.pct }}%"></i></div></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}<p class="empty">Sin datos de carga diaria.</p>{% endif %}
</section>

<section>
  <h2>Recuperación</h2>
  {% if daily_rows %}
  <table>
    <thead><tr><th>Día</th><th class="num">HRV</th><th class="num">FC reposo</th><th class="num">Sueño</th><th class="num">Puntaje sueño</th></tr></thead>
    <tbody>
      {% for m in daily_rows %}
      <tr>
        <td>{{ m.day }}</td><td class="num">{{ m.hrv }}</td><td class="num">{{ m.rhr }}</td>
        <td class="num">{{ m.sleep }}</td><td class="num">{{ m.sleep_score }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <p class="meta" style="color: var(--muted); font-size: 0.85rem;">
    Semana vs. baseline 28 días —
    HRV: {{ wk_vs.hrv }} · FC reposo: {{ wk_vs.rhr }} · Sueño: {{ wk_vs.sleep }}
  </p>
  {% else %}<p class="empty">Sin métricas diarias esta semana.</p>{% endif %}
</section>

<section>
  <h2>Bloque actual vs. bloque anterior (28 días)</h2>
  <table>
    <thead><tr><th>&nbsp;</th><th class="num">Actual</th><th class="num">Anterior</th><th class="num">Δ</th></tr></thead>
    <tbody>
      {% for row in block_rows %}
      <tr>
        <td>{{ row.label }}</td><td class="num">{{ row.current }}</td><td class="num">{{ row.previous }}</td>
        <td class="num {{ row.delta_class }}">{{ row.delta }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>

<footer>
  Cobertura de datos: {{ coverage_line }}<br>
  Reporte congelado generado desde snapshot ({{ schema_version }}). Fuente: {{ providers_line }}.
</footer>
</div>
</body>
</html>
