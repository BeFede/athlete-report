<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ week_title }}</title>
<style>
{% include "_style.css" %}
</style>
</head>
<body>
<header class="hero">
  <div class="wrap">
    <p class="kicker">Reporte semanal de entrenamiento</p>
    <h1>{{ week_title }}</h1>
    <p class="meta">Generado el {{ generated_on }}</p>
    <p class="meta">Datos sincronizados hasta el {{ data_as_of_on }}</p>
    {% if rebuilt_on %}<p class="meta">Reconstruido el {{ rebuilt_on }}</p>{% endif %}
    {% if fitness.status %}<span class="badge">Estado COROS: {{ fitness.status }}</span>{% endif %}
  </div>
</header>
<div class="wrap">

<nav class="weeknav">
  {% if nav.prev %}<a href="../{{ nav.prev }}/">&larr; Semana anterior</a>{% else %}<span class="disabled">&larr; Semana anterior</span>{% endif %}
  {% if nav.next %}<a href="../{{ nav.next }}/">Semana siguiente &rarr;</a>{% else %}<span class="disabled">Semana siguiente &rarr;</span>{% endif %}
  <span class="spacer"></span>
  <label>
    Semana:
    <select onchange="if(this.value)location.href='../'+this.value+'/'">
      {% for w in nav.weeks %}
      <option value="{{ w.value }}" {% if w.value == nav.current %}selected{% endif %}>{{ w.label }}</option>
      {% endfor %}
    </select>
  </label>
  <a href="../{{ nav.latest }}/">Última semana</a>
  <a href="../../archive/">Archivo</a>
</nav>

<div class="cards">
  <div class="card accent"><div class="label">Sesiones</div><div class="value">{{ totals.sessions }}</div></div>
  <div class="card accent"><div class="label">Tiempo</div><div class="value">{{ totals.duration }}</div></div>
  <div class="card accent"><div class="label">Distancia</div><div class="value">{{ totals.distance }}</div></div>
  <div class="card accent"><div class="label">Desnivel</div><div class="value">{{ totals.elevation }}</div></div>
  <div class="card accent"><div class="label">Carga semanal</div><div class="value">{{ totals.load }}</div></div>
  <div class="card"><div class="label">Fitness</div><div class="value">{{ fitness.fitness }}</div><div class="sub">carga 42 días</div></div>
  <div class="card"><div class="label">Fatiga</div><div class="value">{{ fitness.fatigue }}</div><div class="sub">carga 7 días</div></div>
  <div class="card"><div class="label">Forma</div><div class="value">{{ fitness.form }}</div><div class="sub">fitness − fatiga</div></div>
</div>

<section>
  <h2>Actividades <small>tocá una para ver el detalle</small></h2>
  {% if activities %}
  <div class="activity-list">
    <div class="activity-head">
      <span>Día</span><span>Actividad</span><span class="num">Tiempo</span><span class="num">Distancia</span><span class="num">FC</span><span class="num">Carga</span><span class="num">Desnivel</span><span></span>
    </div>
    {% for a in activities %}
    <details class="activity" {% if not a.has_detail %}data-empty="1"{% endif %}>
      <summary>
        <span class="a-day">{{ a.day }}</span>
        <span class="a-name">{{ a.name }} <span class="chip {{ a.sport }}">{{ a.sport_label }}</span></span>
        <span class="num">{{ a.duration }}</span>
        <span class="num">{{ a.distance }}</span>
        <span class="num">{{ a.avg_hr }}</span>
        <span class="num">{{ a.load }}</span>
        <span class="num">{{ a.elev }}</span>
        <span class="a-chevron">{% if a.has_detail %}&#9662;{% endif %}</span>
      </summary>
      {% if a.has_detail %}
      <div class="a-detail">
        {% if a.stats %}
        <div class="a-stats">
          {% for s in a.stats %}
          <div class="a-stat"><span class="label">{{ s.label }}</span><span class="value">{{ s.value }}</span></div>
          {% endfor %}
        </div>
        {% endif %}
        {% if a.splits %}
        <div class="table-wrap">
        <table class="splits">
          <thead><tr><th>Km</th><th>Ritmo</th><th style="width:38%">&nbsp;</th><th class="num">FC</th><th class="num">Desnivel</th></tr></thead>
          <tbody>
            {% for s in a.splits %}
            <tr>
              <td>{{ s.km }}</td>
              <td class="num{% if s.fastest %} fastest{% endif %}">{{ s.pace }}</td>
              <td><div class="split-bar"><i style="width: {{ s.pct }}%"></i></div></td>
              <td class="num">{{ s.hr }}</td>
              <td class="num">{{ s.elev }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        </div>
        {% endif %}
      </div>
      {% endif %}
    </details>
    {% endfor %}
  </div>
  {% else %}<p class="empty">Sin actividades registradas esta semana.</p>{% endif %}
</section>

{% if has_charts %}
<section>
  <h2>La semana en gráficos</h2>
  <div class="charts">
    {% if charts.distance %}
    <div class="chart-card"><h3>Distancia por día</h3><p class="sub">km</p>{{ charts.distance }}</div>
    {% endif %}
    {% if charts.load %}
    <div class="chart-card"><h3>Carga por día</h3><p class="sub">training load</p>{{ charts.load }}</div>
    {% endif %}
    {% if charts.hrv %}
    <div class="chart-card"><h3>HRV nocturno</h3><p class="sub">ms · línea punteada: media 28 días</p>{{ charts.hrv }}</div>
    {% endif %}
    {% if charts.rhr %}
    <div class="chart-card"><h3>FC en reposo</h3><p class="sub">ppm · línea punteada: media 28 días</p>{{ charts.rhr }}</div>
    {% endif %}
    {% if charts.sleep %}
    <div class="chart-card"><h3>Sueño</h3><p class="sub">horas · línea punteada: media 28 días</p>{{ charts.sleep }}</div>
    {% endif %}
  </div>
</section>
{% endif %}

<section>
  <h2>Recuperación <small>semana vs. baseline 28 días</small></h2>
  {% if daily_rows %}
  <p style="margin: 0 0 10px; font-size: 0.9rem;">
    HRV: <strong>{{ wk_vs.hrv }}</strong> · FC reposo: <strong>{{ wk_vs.rhr }}</strong> · Sueño: <strong>{{ wk_vs.sleep }}</strong>
  </p>
  <details class="data-table">
    <summary>Ver tabla diaria</summary>
    <div class="table-wrap">
    <table>
      <thead><tr><th>Día</th><th class="num">HRV</th><th class="num">FC reposo</th><th class="num">Sueño</th><th class="num">Puntaje sueño</th><th class="num">Carga</th></tr></thead>
      <tbody>
        {% for m in daily_rows %}
        <tr>
          <td>{{ m.day }}</td><td class="num">{{ m.hrv }}</td><td class="num">{{ m.rhr }}</td>
          <td class="num">{{ m.sleep }}</td><td class="num">{{ m.sleep_score }}</td><td class="num">{{ m.load }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
  </details>
  {% else %}<p class="empty">Sin métricas diarias esta semana.</p>{% endif %}
</section>

<section>
  <h2>Bloque actual vs. bloque anterior <small>28 días</small></h2>
  <div class="table-wrap">
  <table>
    <thead><tr><th>&nbsp;</th><th class="num">Actual</th><th class="num">Anterior</th><th class="num">Δ</th></tr></thead>
    <tbody>
      {% for row in block_rows %}
      <tr>
        <td>{{ row.label }}</td><td class="num">{{ row.current }}</td><td class="num">{{ row.previous }}</td>
        <td class="num {{ row.delta_class }}">{{ row.delta }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
</section>

<footer>
  Cobertura de datos: {{ coverage_line }}<br>
  Reporte congelado generado desde snapshot ({{ schema_version }}). Fuente: {{ providers_line }}.
</footer>
</div>
</body>
</html>
